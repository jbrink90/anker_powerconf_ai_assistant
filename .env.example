# --- Service endpoints (LAN host running speaches + ollama) ---
SPEACHES_BASE_URL=http://192.168.1.100:8000
OLLAMA_BASE_URL=http://192.168.1.100:11434

# --- Models ---
STT_MODEL=Systran/faster-distil-whisper-small.en
TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_VOICE=am_santa
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Chat provider ---
# ollama = local Ollama (OLLAMA_BASE_URL / OLLAMA_MODEL above)
# openai = OpenAI-compatible /v1/chat/completions — also works with
#          Open WebUI (OPENAI_BASE_URL=http://<host>:<port>/api), LM Studio, etc.
CHAT_PROVIDER=ollama
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# STT_PROVIDER: speaches (local) or openai (uses OPENAI_* above + STT_MODEL —
# e.g. whisper-1, gpt-4o-mini-transcribe, gpt-4o-transcribe)
STT_PROVIDER=speaches

# --- TTS provider ---
# speaches = local Speaches server (uses TTS_MODEL/TTS_VOICE above)
# fish     = Fish Audio cloud API
# openai   = OpenAI TTS (uses OPENAI_* above; TTS_MODEL=tts-1 or gpt-4o-mini-tts,
#            TTS_VOICE=alloy|echo|fable|onyx|nova|shimmer)
TTS_PROVIDER=speaches
FISH_AUDIO_BASE_URL=https://api.fish.audio
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2
# Voice/reference model ID from your Fish Audio account; empty = default voice
FISH_AUDIO_VOICE=

# --- Assistant behavior ---
# 1 = skip Ollama and speak the transcript back (mic/TTS fidelity testing)
ECHO_MODE=0
# 1 = save mic captures and TTS output as wav files in ./recordings/
SAVE_AUDIO=0
# 1 = serve the web UI (web/dist) + live event feed on WEB_UI_PORT
WEB_UI=0
WEB_UI_PORT=8765
# 1 = run spectral-gating noise reduction on mic input before STT
#     (saves in_filtered_*.wav alongside in_*.wav when SAVE_AUDIO=1)
NOISE_REDUCE=0
# 1 = stream chat + per-sentence TTS (fastest time-to-first-audio)
# 0 = wait for the full reply, then one TTS call (fewer API calls, no seams)
STREAMING=1
# Wav file played on a double-tap of the play button (relative to the project dir)
DOUBLE_TAP_WAV=not_found.wav
SYSTEM_PROMPT=You are CJ, a warm, attentive voice assistant and conversational companion. Be relaxed, grounded, loyal, streetwise, and lightly funny, with a casual, confident edge. Keep it natural: don't force slang, act tough, or use catchphrases. Respond to the person, not just the literal task: acknowledge feelings or context when relevant, ask one thoughtful follow-up when it helps, and remember details from the conversation. Keep spoken replies concise by default, usually one or two sentences, but allow room for real conversation or more detail when useful. Use plain text without lists or markdown. Use only tools actually available in this conversation: web_search for current information, and any additional tools explicitly provided by connected MCP servers. Use tools when useful, but answer naturally without tools for opinions, jokes, or small talk. When a tool returns information, summarize it in your own words. If a tool fails, say so briefly and move on.

# --- Audio devices ---
# Input: substring matched against `pactl list sources short` (e.g. bluez) — captured
# via pacat, which keeps working while the speaker is playing (PortAudio does not).
# Output: substring matched against PortAudio device names. When empty, the
# assistant prefers device names containing PowerConf/Anker/BlueZ/Bluetooth,
# then uses the system default.
AUDIO_INPUT_DEVICE=bluez
AUDIO_OUTPUT_DEVICE=
SAMPLE_RATE=16000

# --- Buttons ---
# Substring matched (case-insensitive) against evdev input device names.
# BlueZ exposes remote AVRCP keys as "<device name> (AVRCP)".
BUTTON_DEVICE_NAME=AVRCP
# 1 = if no name match, use any device with media keys (may include a TV remote).
# 0 = only use the named AVRCP device.
BUTTON_FALLBACK=0
# Command used for volume keys. {op} is replaced with +5% / -5% / toggle.
VOLUME_COMMAND=pactl set-sink-volume @DEFAULT_SINK@ {op}
MUTE_COMMAND=pactl set-sink-mute @DEFAULT_SINK@ toggle
# Volume set once when the speaker connects (e.g. 76%); empty = leave as-is
STARTUP_VOLUME=

# --- VAD tuning (always-listening mode) ---
VAD_SPEECH_MS=250
VAD_SILENCE_MS=900
VAD_MAX_UTTERANCE_S=30
# RMS threshold multiplier over measured noise floor, and absolute floor
VAD_THRESHOLD_FACTOR=3.0
VAD_MIN_RMS=300

# --- Wake word (optional, needs `pip install openwakeword`) ---
# Built-in: hey_jarvis, alexa, hey_mycroft, hey_rhasspy, timer, weather.
# Or point to a custom openWakeWord .onnx/.tflite model file.
# Empty = always-listening, no wake word
WAKEWORD_MODEL=hey_jarvis
# Transcript phrase to strip after activation; empty derives it from the model name.
# For a custom file, set e.g. WAKEWORD_PHRASE=Hey CJ.
WAKEWORD_PHRASE=
# Start here, then tune using `python main.py wakecal` on the Pi.
WAKEWORD_THRESHOLD=0.55
# Minimum seconds between wake-word triggers; also suppresses detection for
# this long after playback ends so TTS reverb can't re-trigger the mic.
WAKEWORD_COOLDOWN_S=4
# Play a short rising tone immediately after wake-word detection.
WAKE_ACK_TONE=1

# --- Barge-in ---
# 1 = speaking over the assistant during playback interrupts it and your speech
# becomes the next command. Relies on the PowerConf's echo cancellation keeping
# the mic clean while playing.
BARGE_IN=1
# Barge-in sensitivity: absolute RMS floor, and multiplier over the calibrated
# VAD threshold — effective threshold = max(MIN_RMS, vad_threshold * FACTOR).
# Check the "peak mic rms" in the "Barge-in watcher done" log line to tune these.
BARGE_IN_MIN_RMS=300
BARGE_IN_FACTOR=1.0
# After a reply ends, keep listening this many seconds for a follow-up command
# without requiring the wake word again. 0 = off.
FOLLOWUP_S=10

# --- MCP tool servers (optional, needs `pip install mcp`) ---
# JSON array on ONE line. Each entry: {"name","command","args","env"}.
# Most community servers run via npx or uvx, which must be installed on the Pi.
# Example (filesystem access, read-only demo):
# MCP_SERVERS=[{"name":"fetch","command":"uvx","args":["mcp-server-fetch"]},{"name":"wikipedia","command":"uvx","args":["wikipedia-mcp"]},{"name":"weather","command":"uvx","args":["chuk-mcp-open-meteo"]},{"name":"time","command":"uvx","args":["mcp-server-time"]},{"name":"shell","command":"uvx","args":["mcp-shell-server"],"env":{"ALLOW_COMMANDS":"ls,cat,pwd,echo,date,uptime,vcgencmd,free,df,hostname"}},{"name":"memory","command":"npx","args":["-y","@modelcontextprotocol/server-memory"]}]
MCP_SERVERS=
